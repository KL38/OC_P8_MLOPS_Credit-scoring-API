# Large generated artefact — produced by scripts/build_feature_store.py.
# Too large for git (~100-300 MB); rebuild from the OC_P6 data when needed.
data/features_store.parquet

# Drift reference snapshot — generated by scripts/build_reference_dataset.py,
# stored on the HF Dataset (KLEB38/oc-p8-features). Local copy is regenerated
# on demand.
data/reference_dataset.parquet

# Kaggle Home Credit raw data — used to source the TARGET column for the
# reference dataset. Big (~165 MB) and personal data, never committed.
data/application_train.csv
data/*.csv

# Generated Evidently HTML + JSON snapshot — produced by
# scripts/generate_drift_report.py. Big (~40 MB HTML); shipped to the
# monitoring Space via huggingface_hub upload_folder, never via git.
dashboard/static/drift_report.html
dashboard/static/drift_report.json

# The metadata JSONs (feature_names, app_train_columns, app_train_categories,
# app_train_binary_mappings, no_history_template) are intentionally COMMITTED:
# they are small (<100 KB total) and required by the Docker build. Regenerate
# them with:  uv run python scripts/build_feature_store.py

# Project-local logs / scratch
scratch/
tmp/

# cProfile / line_profiler outputs (étape 4) — regenerable via
